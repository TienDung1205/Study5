{
  "name": "toeic-quest-800",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:deploy": "npm run prisma:deploy --workspace backend",
    "prisma:push": "npm run prisma:push --workspace backend",
    "prisma:seed": "npm run prisma:seed --workspace backend",
    "vocabulary:build": "node scripts/build-vocabulary-bank.mjs --translate",
    "db:setup": "npm run prisma:generate && npm run prisma:deploy && npm run prisma:seed"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0"
  }
}
